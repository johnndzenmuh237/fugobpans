# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Your website origin(s), comma separated, no trailing slash. In production this is your Firebase Hosting URL / custom domain.
CLIENT_ORIGIN=http://localhost:5500
# Set true only if this server should ALSO serve the website (not needed with Firebase Hosting).
SERVE_FRONTEND=false

# ---------- Database (Neon) ----------
# Neon dashboard > Connect. For the running API you may use the pooled ("-pooler") string;
# for `npm run migrate` / `npm run upgrade-db` use the DIRECT string. Must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# ---------- Security ----------
# Long random string (at least 32 characters). Render can generate this for you.
JWT_SECRET=

# ---------- Payments ----------
PAYMENT_PROVIDER=
CAMPAY_BASE_URL=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=

# ---------- Email (needed for "forgot password" links to be emailed) ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

AI_API_KEY=
AI_MODEL=

# ---------- SMS / WhatsApp (fee reminders, tracking-number recovery, record verification) ----------
# Pick ONE provider in the app: Fee Reminders > Settings. Leave the others empty. Secrets belong here, never in the website.
SCHOOL_TZ=Africa/Douala
# Twilio (SMS and/or WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Meta WhatsApp Cloud API (business-initiated messages must use an APPROVED template with one body variable {{1}})
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Generic SMS gateway (POST JSON {to, message, sender} with a Bearer token)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_SENDER=
