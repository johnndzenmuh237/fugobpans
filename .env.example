# ==== SERVER ====
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://your-school-site.example.com

# ==== DATABASE (PostgreSQL — Neon, Supabase, Railway, or any Postgres host) ====
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=true

# ==== AUTH (plain JWT + bcrypt — no Firebase) ====
JWT_SECRET=replace_with_a_long_random_string

# ==== PAYMENT (Campay — routes both MTN Mobile Money and Orange Money) ====
PAYMENT_PROVIDER=campay
CAMPAY_BASE_URL=https://www.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=https://your-api.example.com/api/payments/webhook

# ==== EMAIL (receipts sent to guardian email — spec §19) ====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="FUGOBPANS <no-reply@fugobpans.example>"

# ==== AI ANALYTICS (optional — leave blank until configured, spec §91) ====
AI_API_KEY=
AI_MODEL=

# ==== SCHOOL DEFAULTS (also editable later in Settings) ====
SCHOOL_CURRENCY=FCFA
DEFAULT_TIMEZONE=Africa/Douala
